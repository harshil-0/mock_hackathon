# Copy to .env and fill in. NEVER commit .env.

# --- LLM ---
# anthropic | openai
LLM_PROVIDER=anthropic
# Leave empty to use the default for the provider
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Pipeline switches (see PLAN.md sections 3 to 5) ---
# dynamic | fixed
CHUNK_MODE=dynamic
# hybrid | dense
RETRIEVAL=hybrid
GATE_LOW=0.20
TOP_K=5
# Defaults to data/index_<CHUNK_MODE> when empty
INDEX_DIR=
